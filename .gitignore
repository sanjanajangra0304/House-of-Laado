apps/api/public/uploads/*
!apps/api/public/uploads/.gitkeep

# Logs
*.log
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Browser profiles and capture temp data
docs/reference-screenshots/*profile*
docs/reference-screenshots/*temp*
docs/reference-screenshots/*local*

# Editor directories and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

