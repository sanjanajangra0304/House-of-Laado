# =========================================================================
# HOUSE OF LAADO — BACKEND REST API ENVIRONMENT CONFIGURATION
# =========================================================================

# Server Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
# Local: mongodb://localhost:27017/house_of_laado
# Production (Atlas): mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/house_of_laado?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/house_of_laado
MONGODB_DB_NAME=house_of_laado

# JWT Authentication (generate a random 32+ character hex string in production)
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (automatically provisioned in MongoDB)
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# Razorpay Payment Gateway (Indian Rupee INR)
# Obtain keys at: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary Media Storage (Catalog image optimization)
# Obtain credentials at: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Transactional Email Service (Resend official integration or SMTP fallback)
# Obtain Resend API key at: https://resend.com/api-keys
RESEND_API_KEY=re_placeholder_resend_api_key
EMAIL_FROM="House of Laado <orders@houseoflaado.com>"
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Optional SMTP Fallback
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=placeholder_smtp_password

# Logistics & Courier Tracking (Delhivery / Shiprocket)
DELHIVERY_API_KEY=placeholder_delhivery_api_key
SHIPROCKET_EMAIL=operations@houseoflaado.com
SHIPROCKET_PASSWORD=placeholder_shiprocket_password
