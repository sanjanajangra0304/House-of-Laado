# =========================================================================
# HOUSE OF LAADO — NEXT.JS STOREFRONT ENVIRONMENT CONFIGURATION
# =========================================================================

# Brand Identity
NEXT_PUBLIC_STORE_NAME="House of Laado"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Backend REST API Base URL
# Local: http://localhost:5000/api/v1
# Production: https://house-of-laado-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Razorpay Checkout Public Key (Test or Live Key ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# Social Media Profiles (Optional: overrides defaults in config/brand.js)
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/house.of.laado/"
